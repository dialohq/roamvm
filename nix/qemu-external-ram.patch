+++ b/migration/savevm.c
@@ -281,0 +282 @@ static bool should_validate_capability(int capability)
+    case MIGRATION_CAPABILITY_X_ROAMVM_EXTERNAL_RAM:
diff --git a/qapi/migration.json b/qapi/migration.json
index cf023bd..546cf90 100644
--- a/qapi/migration.json
+++ b/qapi/migration.json
@@ -529,0 +530,7 @@
+# @x-roamvm-external-ram: Skip named file RAM, including private
+#     mappings.  The caller must stop the VM, capture its live RAM
+#     separately (not the backing file), and bind that capture
+#     to the CPU/device stream before publishing a checkpoint.  Both
+#     ends must enable this capability.  Incompatible with postcopy.
+#     This is a RoamVM extension, disabled by default.  (since 10.2)
+#
@@ -550 +557,2 @@
-           'dirty-limit', 'mapped-ram'] }
+           'dirty-limit', 'mapped-ram',
+           { 'name': 'x-roamvm-external-ram', 'features': [ 'unstable' ] }] }
