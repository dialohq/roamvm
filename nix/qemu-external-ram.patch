diff --git a/migration/options.c b/migration/options.c
index e78324b..e2eb495 100644
--- a/migration/options.c
+++ b/migration/options.c
@@ -269 +269,9 @@ bool migrate_ignore_shared(void)
-    return s->capabilities[MIGRATION_CAPABILITY_X_IGNORE_SHARED];
+    return s->capabilities[MIGRATION_CAPABILITY_X_IGNORE_SHARED] ||
+           migrate_ignore_file_backed();
+}
+
+bool migrate_ignore_file_backed(void)
+{
+    MigrationState *s = migrate_get_current();
+
+    return s->capabilities[MIGRATION_CAPABILITY_X_ROAMVM_EXTERNAL_RAM];
diff --git a/migration/options.h b/migration/options.h
index a7b3262..ed07663 100644
--- a/migration/options.h
+++ b/migration/options.h
@@ -33,0 +34 @@ bool migrate_ignore_shared(void);
+bool migrate_ignore_file_backed(void);
diff --git a/migration/ram.c b/migration/ram.c
index 29f016c..39ca644 100644
--- a/migration/ram.c
+++ b/migration/ram.c
@@ -234,2 +234,2 @@ bool migrate_ram_is_ignored(RAMBlock *block)
-           (migrate_ignore_shared() && qemu_ram_is_shared(block)
-                                    && qemu_ram_is_named_file(block));
